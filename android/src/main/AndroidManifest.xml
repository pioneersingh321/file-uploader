<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for file upload/download -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!--
            FileProvider for secure, backward-compatible URI sharing.
            android:authorities uses ${applicationId} so the consuming app's package name
            is substituted at build time — required for FileProvider to work correctly
            inside a library module.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
